{
  "name": "boostboost",
  "version": "0.1.0",
  "private": true,
  "description": "BoostBoost emotion check-in service, exposed as both a REST API and an MCP tool server for agent copilots.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "start:api": "node dist/api/server.js",
    "start:mcp": "node dist/mcp/server.js",
    "dev:api": "tsx src/api/server.ts",
    "dev:mcp": "tsx src/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/core/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
